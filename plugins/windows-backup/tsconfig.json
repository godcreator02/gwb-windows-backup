{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    // 只能是 bundler，不能是 nodenext：cordis 的 .d.ts 在 nodenext 下类型检查不过
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // node 侧每个文件都要列进 include：oxlint 的 type-aware 只认 include，漏列的文件全变成 error 类型，no-unsafe-* 全部报错
  "include": ["src/*.ts", "build.ts", "tests/**/*.ts"]
}
