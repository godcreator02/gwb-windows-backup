{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    // 浏览器半看不见 node 全局：不给空表的话 @types/node 会自动收进来，
    // 写一句 process.env 也不报错，而束里根本没有它
    "types": [],
    "noEmit": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["."]
}
