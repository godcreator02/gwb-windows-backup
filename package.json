{
  "name": "@godcreator/gwb-windows-backup",
  "version": "0.1.1",
  "author": {"name": "godcreator"},
  "description": "Windows 备份件：restic 快照 + Veeam 整机镜像 + 阿里云 OSS 异地库三栈；配置与状态落盘，headless home 里照跑（shell 与 shared-react 走可选 peer）。服务无；skill 0 份；命令 6 条。",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "config"],
  "gwb": { "title": "Windows 备份" },
  "keywords": ["gwb", "gwb-plugin"],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-windows-backup.git"
  },
  "scripts": {
    "//build": "三步：node 半 tsc、浏览器半 esbuild（react 外置走 importmap）、样式 tailwindcss 前缀直出",
    "build": "tsc -p tsconfig.build.json && node build.ts && tailwindcss -i src/client/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "//prepublishOnly": "发版前强制构建一次。pnpm check 不构建，少了这条会把上一版的 dist 原样发出去——静默的",
    "prepublishOnly": "pnpm build"
  },
  "engines": { "node": ">=24" },
  "//peer": "硬 peer 五条：commands（写面全在总线上）、settings（配置 SSOT）、data（状态与凭据落盘）是备份的命根，缺哪个这个件都没有意义；plugin-api 的类型出现在 dist/index.d.ts 的导出面；tokens 供样式映射面（theme.reference.css，构建期吃）。定时器走官方 @cordisjs/plugin-timer（内核 AGENTS 认定的开件），由 home 的 yml 条目提供——跟 cordis 一样是宿主环境给的，只进 dev 不进 peer。shell / shared-react 是浏览器半的前提，走可选 peer——headless home（没外壳）里备份照跑，缺了只是没有界面",
  "peerDependencies": {
    "@godcreator/gwb-plugin-api": "^0.1.2",
    "@godcreator/gwb-commands": "^0.4.3",
    "@godcreator/gwb-settings": "^0.2.1",
    "@godcreator/gwb-data": "^0.1.2",
    "@godcreator/gwb-shell": "^0.9.1",
    "@godcreator/gwb-shared-react": "^0.1.0",
    "@godcreator/gwb-tokens": "^0.1.3"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-shell": {
      "optional": true
    },
    "@godcreator/gwb-shared-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cordisjs/plugin-timer": "1.1.3",
    "@godcreator/gwb-commands": "0.4.3",
    "@godcreator/gwb-data": "0.1.2",
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-repo-kit": "0.2.3",
    "@godcreator/gwb-settings": "0.2.1",
    "@godcreator/gwb-shared-react": "0.1.0",
    "@godcreator/gwb-shell": "0.9.1",
    "@godcreator/gwb-tokens": "0.1.3",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/node": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cordis": "4.0.0-rc.9",
    "esbuild": "^0.27.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
