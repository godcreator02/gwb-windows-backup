{
  "name": "@godcreator/gwb-windows-backup",
  "version": "0.1.1",
  "author": {"name": "godcreator"},
  "description": "Windows 备份件：restic 快照 + Veeam 整机镜像 + 阿里云 OSS 异地库三栈；配置与状态落盘，headless home 里照跑（shell 与 shared-react 走可选 peer）。服务无；skill 0；命令 6 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "config"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.ts && node tools/build-styles.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "prepublishOnly": "pnpm build",
    "publish:dev": "node scripts/publish.ts",
    "publish:release": "node scripts/publish.ts --release"
  },
  "engines": {
    "node": ">=24"
  },
  "//peer": "硬 peer 四条：commands（写面全在总线上）、settings（配置 SSOT）、data（状态与凭据落盘）是备份的命根，缺哪个这个件都没有意义；plugin-api 的类型出现在 dist/index.d.ts 的导出面;定时器走官方 @cordisjs/plugin-timer(内核 AGENTS 认定的开件),由 home 的 yml 条目提供——跟 cordis 一样是宿主环境给的,只进 dev 不进 peershell / shared-react 是**浏览器半的前提**，走可选 peer——headless home（没外壳）里备份照跑，那三个缺了只是没有界面",
  "peerDependencies": {
    "@godcreator/gwb-plugin-api": "^0.1.2",
    "@godcreator/gwb-commands": "^0.4.3",
    "@godcreator/gwb-settings": "^0.2.1",
    "@godcreator/gwb-data": "^0.1.2",
    "@godcreator/gwb-shell": "^0.9.1",
    "@godcreator/gwb-shared-react": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-shell": {
      "optional": true
    },
    "@godcreator/gwb-shared-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cordisjs/plugin-timer": "1.1.3",
    "@godcreator/gwb-commands": "0.4.3",
    "@godcreator/gwb-data": "0.1.2",
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-settings": "0.2.1",
    "@godcreator/gwb-shared-react": "0.1.0",
    "@godcreator/gwb-shell": "0.9.1",
    "@godcreator/gwb-tokens": "0.1.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cordis": "4.0.0-rc.9",
    "esbuild": "^0.27.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "^8.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-windows-backup.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
