{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // 本仓只有这一份 node 半 typecheck program：src 的 node 半、纯逻辑测试、构建脚本一起收。
    // **emit 不走这份**——build 走 tsconfig.build.json（rootDir 才关得住 src）。
    // client 的 .tsx 不进这份（lib 里没有 DOM）——它有自己的 src/client/tsconfig.json；
    // "src/*.ts" 与 "src/client/**/*.ts" 都只匹配 .ts，恰好放进来的是 client 里的纯逻辑文件
    "noEmit": true,
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  "include": [
    "src/*.ts",
    "src/client/**/*.ts",
    "tests/**/*.test.ts",
    "build.ts",
    "tools/build-styles.ts",
    "scripts/publish.ts",
    "vitest.config.ts"
  ]
}
